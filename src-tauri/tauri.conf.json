{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TFTN",
  "version": "0.1.3",
  "identifier": "org.tftn.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TFTN",
        "width": 1200,
        "height": 850,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: tftn: http://tftn.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../_lokal/typst-cli/0.15.1/typst"
    ],
    "resources": {
      "../_lokal/typst-cli/0.15.1/LICENSE": "lizenzen/typst-LICENSE.txt",
      "../types/": "types/",
      "../package-descriptions/": "package-descriptions/",
      "../dictionaries/": "dictionaries/",
      "../languages/": "languages/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
