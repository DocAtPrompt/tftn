{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brief",
  "type": "object",
  "required": ["empfaenger"],
  "x-tftn-reihenfolge": ["absender", "empfaenger", "ort", "datum", "betreff", "gruss", "unterschrift", "sprache"],
  "properties": {
    "absender": {
      "type": "object",
      "title": "Absender",
      "x-tftn-gruppe": "Absender",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "title": "Name" },
        "zeilen": { "type": "array", "title": "Anschrift", "description": "Straße, Postleitzahl und Ort, je Zeile ein Eintrag", "items": { "type": "string" } },
        "telefon": { "type": "string", "title": "Telefon" },
        "email": { "type": "string", "title": "E-Mail", "format": "email" }
      }
    },
    "empfaenger": {
      "type": "array",
      "title": "Empfänger",
      "description": "Anschrift im Fenster, je Zeile ein Eintrag",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "ort": { "type": "string", "title": "Ort" },
    "datum": { "type": "string", "title": "Datum", "format": "date" },
    "betreff": { "type": "string", "title": "Betreff" },
    "gruss": { "type": "string", "title": "Grußformel", "default": "Mit freundlichen Grüßen" },
    "unterschrift": { "type": "string", "title": "Name unter der Unterschrift", "description": "Leer: der Name des Absenders" },
    "sprache": {
      "type": "string",
      "title": "Sprache",
      "description": "Sprache des Briefs: Silbentrennung, Rechtschreibung, Datum und Seitenzahlen",
      "default": "de",
      "oneOf": [
        { "const": "de", "title": "Deutsch" },
        { "const": "en", "title": "Englisch" }
      ]
    }
  }
}
