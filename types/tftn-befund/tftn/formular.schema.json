{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Befund",
  "type": "object",
  "required": ["titel", "patient"],
  "x-tftn-reihenfolge": ["titel", "patient", "ort", "datum", "empfaenger", "praxis", "logo", "logo_hoehe", "unterschrift_bild", "gruss", "unterschrift", "sprache"],
  "properties": {
    "titel": { "type": "string", "title": "Art des Dokuments", "description": "z. B. Befund, Arztbrief, Ärztliche Bestätigung", "default": "Befund" },
    "patient": {
      "type": "object",
      "title": "Patient/in",
      "x-tftn-gruppe": "Patient/in",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string", "title": "Name", "x-tftn-sensibel": true,
          "x-tftn-ersatz": { "nach": "patient.geschlecht", "je": { "weiblich": "Patientin", "männlich": "Patient" }, "sonst": "Patient/in" }
        },
        "geschlecht": {
          "type": "string",
          "title": "Geschlecht",
          "description": "Geht im Klartext an KI-Assistenten; bestimmt den Ersatztext für den Namen",
          "oneOf": [
            { "const": "weiblich", "title": "weiblich" },
            { "const": "männlich", "title": "männlich" },
            { "const": "divers", "title": "divers" }
          ]
        },
        "geburtsdatum": { "type": "string", "title": "Geburtsdatum", "format": "date", "x-tftn-sensibel": true, "x-tftn-ersatz": "geb. {jahr}" },
        "svnr": { "type": "string", "title": "Sozialversicherungsnummer", "format": "sv-nummer", "x-tftn-sensibel": true, "x-tftn-ersatz": "SV-Nummer" }
      }
    },
    "ort": { "type": "string", "title": "Ort" },
    "datum": { "type": "string", "title": "Datum", "format": "date" },
    "empfaenger": {
      "type": "array",
      "title": "Empfänger",
      "description": "z. B. zuweisende Ärztin; je Zeile ein Eintrag, leer: kein Empfänger",
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "praxis": {
      "type": "object",
      "title": "Ordination",
      "x-tftn-gruppe": "Ordination",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "title": "Name" },
        "fach": { "type": "string", "title": "Fachrichtung" },
        "zeilen": { "type": "array", "title": "Anschrift", "items": { "type": "string" } },
        "telefon": { "type": "string", "title": "Telefon" },
        "email": { "type": "string", "title": "E-Mail", "format": "email" }
      }
    },
    "logo": { "type": "string", "title": "Logo", "description": "Bilddatei im Projekt (PNG, JPG, SVG …), steht im Kopf links neben dem Namen der Ordination; „Bild wählen …“ legt sie unter bilder/ ab", "format": "bild", "x-tftn-gruppe": "Ordination" },
    "logo_hoehe": { "type": "number", "title": "Höhe des Logos in cm", "default": 1.5, "minimum": 0.5, "maximum": 4, "x-tftn-gruppe": "Ordination" },
    "unterschrift_bild": { "type": "string", "title": "Unterschrift als Bild", "description": "Bild der Unterschrift über dem Namen, am besten ein Scan mit durchsichtigem Hintergrund (PNG); leer: Platz zum Unterschreiben von Hand", "format": "bild", "x-tftn-gruppe": "Ordination" },
    "gruss": { "type": "string", "title": "Grußformel", "default": "Mit freundlichen Grüßen" },
    "unterschrift": { "type": "string", "title": "Name unter der Unterschrift", "description": "Leer: der Name der Ordination" },
    "sprache": {
      "type": "string",
      "title": "Sprache",
      "description": "Sprache des Dokuments: Silbentrennung, Rechtschreibung, Datum und Beschriftungen",
      "default": "de",
      "oneOf": [
        { "const": "de", "title": "Deutsch" },
        { "const": "en", "title": "Englisch" }
      ]
    }
  }
}
