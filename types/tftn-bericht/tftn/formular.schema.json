{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bericht",
  "type": "object",
  "required": ["titel"],
  "x-tftn-reihenfolge": ["titel", "untertitel", "autoren", "institution", "datum", "inhaltsverzeichnis", "sprache", "literatur"],
  "properties": {
    "titel": { "type": "string", "title": "Titel", "x-tftn-pandoc": "title" },
    "untertitel": { "type": "string", "title": "Untertitel", "x-tftn-pandoc": "subtitle" },
    "autoren": { "type": "array", "title": "Autorinnen und Autoren", "items": { "type": "string" }, "x-tftn-pandoc": "author" },
    "institution": { "type": "string", "title": "Institution", "description": "Steht oben auf der Titelseite, z. B. Universität oder Firma" },
    "datum": { "type": "string", "title": "Datum", "format": "date", "x-tftn-pandoc": "date" },
    "inhaltsverzeichnis": { "type": "boolean", "title": "Inhaltsverzeichnis", "default": true },
    "sprache": {
      "type": "string",
      "title": "Sprache",
      "description": "Sprache des Texts: Silbentrennung, Rechtschreibung und Beschriftungen",
      "default": "de",
      "oneOf": [
        { "const": "de", "title": "Deutsch" },
        { "const": "en", "title": "Englisch" }
      ]
    },
    "literatur": {
      "type": "object",
      "title": "Literatur",
      "x-tftn-gruppe": "Literatur",
      "required": ["dateien"],
      "properties": {
        "dateien": {
          "type": "array",
          "title": "Literaturdateien",
          "description": "BibLaTeX (.bib) oder Hayagriva (.yaml), relativ zum Projektordner",
          "minItems": 1,
          "items": { "type": "string", "format": "literaturdatei" }
        },
        "stil": {
          "type": "string",
          "title": "Zitierstil",
          "description": "Eingebauter Stil (z. B. american-psychological-association, ieee) oder eine .csl-Datei im Projekt",
          "format": "zitierstil",
          "default": "american-psychological-association"
        }
      }
    }
  }
}
